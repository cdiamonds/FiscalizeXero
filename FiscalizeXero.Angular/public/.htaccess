Options -MultiViews
RewriteEngine On
RewriteBase /

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything else to index.html for Angular routing
RewriteRule ^ index.html [QSA,L]

# Cache hashed static assets aggressively (Angular adds content hash to filenames)
<FilesMatch "\.(js|mjs|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|webp|avif)$">
  Header set Cache-Control "max-age=31536000, public, immutable"
</FilesMatch>

# Never cache index.html — must always be fresh so updated bundles are picked up
<FilesMatch "^index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# Do not cache the service worker script
<FilesMatch "ngsw\.json|ngsw-worker\.js|safety-worker\.js">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

# Enable gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml text/plain image/svg+xml
</IfModule>

# Security headers
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
# Content Security Policy. Angular needs inline styles; scripts are only ever our own bundles.
# connect-src: the API host. img-src: QR codes (api.qrserver.com) and YouTube thumbnails. frame-src: tutorial videos.
Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://api.qrserver.com https://img.youtube.com; connect-src 'self' https://apps.onaerp.africa https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.youtube.com blob:; worker-src 'self'; manifest-src 'self'; form-action 'self'"
