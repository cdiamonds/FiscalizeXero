<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Fiscalize.LayoutRenderer: the shared layout renderer, packed from the Fiscalyze solution
         (dotnet pack Fiscalize.LayoutRenderer -c Release -o <this repo>/libs) and kept here because this app lives in its
         own repository. Update the file in libs/ and the version in FiscalizeXero.Api.csproj when the renderer changes. -->
    <add key="fiscalize-local" value="libs" />
  </packageSources>
</configuration>
