{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost,1433;Database=FiscalizeXero;User Id=sa;Password=<set-in-user-secrets>;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "PathBase": "/FiscalizeXero",
  "AuthSettings": {
    "Key": "This is the key that we will use in the encryption",
    "Audience": "https://xero.fiscalize.co.zw",
    "Issuer": "https://xero.fiscalize.co.zw"
  },
  "AppMail": {
    "Address": "",
    "Password": "",
    "SMTPPort": 587,
    "SMTPServer": "",
    "EnableSSL": false
  },
  "Fiscalize": {
    "ApiUrl": "https://fiscalize.onaerp.africa"
  },
  "Xero": {
    "ClientId": "",
    "ClientSecret": "",
    "RedirectUri": "https://xero.fiscalize.co.zw/redirect-url",
    "Scope": "openid profile email offline_access accounting.invoices accounting.contacts accounting.settings.read accounting.attachments",
    "ScopeVersion": 1,
    "WebhookKey": "",
    "WebhookCallbackBaseUrl": "https://apps.onaerp.africa",
    "Sync": {
      "Enabled": true,
      "IntervalHours": 6,
      "JitterMinutes": 45,
      "TickSeconds": 300,
      "InitialLookbackMinutes": 60,
      "OverlapMinutes": 10,
      "DelayBetweenCompaniesSeconds": 2,
      "MaxPagesPerRun": 10
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://xero.fiscalize.co.zw"
    ]
  }
}
